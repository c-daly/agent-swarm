  Charts

  Selected Charts (6)

  1. Token Spend Over Time (with 7-day moving average)

  SELECT
    DATE(timestamp) as day,
    SUM(input_tokens + output_tokens) as total_tokens,
    AVG(SUM(input_tokens + output_tokens)) OVER (
      ORDER BY DATE(timestamp) ROWS 6 PRECEDING
    ) as moving_avg_7d
  FROM events
  GROUP BY DATE(timestamp)
  ORDER BY day

  2. Token Spend by Agent Type

  SELECT
    COALESCE(agent_type, 'main') as agent_type,
    SUM(input_tokens + output_tokens) as total_tokens,
    COUNT(DISTINCT session_id) as sessions
  FROM events
  GROUP BY agent_type
  ORDER BY total_tokens DESC

  3. Cache Efficiency Trend

  SELECT
    DATE(timestamp) as day,
    SUM(cache_read_tokens) as cached,
    SUM(input_tokens) as total_input,
    ROUND(100.0 * SUM(cache_read_tokens) / NULLIF(SUM(input_tokens), 0), 1) as cache_pct
  FROM events
  GROUP BY DATE(timestamp)

  4. Tool Latency by Backend

  SELECT
    backend,
    AVG(duration_ms) as avg_latency,
    PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY duration_ms) as p95
  FROM events
  WHERE duration_ms > 0
  GROUP BY backend

  5. Error Rate by Tool

  SELECT
    tool,
    COUNT(*) as total_calls,
    SUM(CASE WHEN status = 'error' THEN 1 ELSE 0 END) as errors,
    ROUND(100.0 * SUM(CASE WHEN status = 'error' THEN 1 ELSE 0 END) / COUNT(*), 1) as error_pct
  FROM events
  GROUP BY tool
  ORDER BY error_pct DESC

