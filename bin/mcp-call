#!/usr/bin/env python3
"""
MCP tool caller for subagents - restricted to router backends only.

Usage:
  mcp-call [--cwd=<path>] <tool_name> [args]

Options:
  --cwd=<path>    Set working directory for shell commands

Arguments can be JSON or Python dict syntax:
  JSON:   '{"key": "value", "flag": true}'
  Python: "{'key': 'value', 'flag': True}"

Examples:
  mcp-call serena__list_dir '{"relative_path": ".", "recursive": false}'
  mcp-call serena__find_symbol "{'name_path_pattern': 'main', 'include_body': True}"
  mcp-call context7__resolve-library-id '{"libraryName": "react"}'
  mcp-call --cwd=/path/to/repo git status
"""
import ast
import json
import sys
import os

# Add lib to path - resolve symlinks to get real script location
script_dir = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(script_dir, '..', 'lib'))

from daemon_client import DaemonClient


def call_tool(name, arguments):
    """Call a tool via the router daemon."""
    with DaemonClient() as dc:
        return dc.call_tool(name, arguments)


def list_tools():
    """List available tools from the router daemon."""
    with DaemonClient() as dc:
        return dc.list_tools()


# Explicitly blocked tools (shell execution, code injection vectors)
BLOCKED_TOOLS = {
    "serena__execute_shell_command",  # Shell execution - bypasses bash permissions
    "playwright__browser_run_code",   # Code execution in browser
}

# Shell command aliases - route these to native__bash
SHELL_ALIASES = {"pytest", "ruff", "mypy", "black", "git", "gh", "python", "python3", "poetry"}


def parse_args(arg_string: str) -> dict:
    """Parse arguments as JSON or Python dict syntax.

    Accepts:
      - JSON: '{"key": "value", "flag": true}'
      - Python dict: "{'key': 'value', 'flag': True}"

    Returns parsed dict, raises ValueError on failure.
    """
    # Try JSON first (most common, backwards compatible)
    try:
        return json.loads(arg_string)
    except json.JSONDecodeError:
        pass

    # Try Python literal (dict syntax)
    try:
        result = ast.literal_eval(arg_string)
        if isinstance(result, dict):
            return result
    except (ValueError, SyntaxError):
        pass

    msg = (
        f"Could not parse as JSON or Python dict: {arg_string}\n"
        f"  JSON example: '{{\"key\": \"value\"}}'\n"
        f"  Python example: \"{{\'key\': \'value\'}}\""
    )
    raise ValueError(msg)


def is_tool_blocked(tool_name: str) -> bool:
    """Check if tool is explicitly blocked (shell execution vectors)."""
    return tool_name in BLOCKED_TOOLS

def main():
    # Parse flags (--cwd, --caller-id)
    cwd = None
    caller_id = None
    args = sys.argv[1:]
    while args and args[0].startswith("--"):
        if args[0].startswith("--cwd="):
            cwd = args[0].split("=", 1)[1]
        elif args[0].startswith("--caller-id="):
            caller_id = args[0].split("=", 1)[1]
        else:
            break
        args = args[1:]

    if len(args) < 1:
        print("Usage: mcp-call [--cwd=<path>] [--caller-id=<id>] <tool_name> [json_args]", file=sys.stderr)
        print("\nShell aliases (routed to bash):", file=sys.stderr)
        print(f"  {', '.join(sorted(SHELL_ALIASES))}", file=sys.stderr)
        print("\nExamples:", file=sys.stderr)
        print("  mcp-call serena__list_dir '{\"relative_path\": \".\"}'", file=sys.stderr)
        print("  mcp-call serena__find_symbol '{\"name_path_pattern\": \"main\"}'", file=sys.stderr)
        sys.exit(1)

    tool_name = args[0]

    # Handle shell aliases - route to native__bash via router
    if tool_name in SHELL_ALIASES:
        # Reconstruct the command from tool_name and remaining args
        command = " ".join([tool_name] + args[1:])
        try:
            call_args = {"command": command}
            if cwd:
                call_args["cwd"] = cwd
            if caller_id:
                call_args["_caller"] = caller_id
            result = call_tool("native__bash", call_args)
            if isinstance(result, (dict, list)):
                print(json.dumps(result, indent=2))
            else:
                print(result)
        except Exception as e:
            print(f"Error running {tool_name}: {e}", file=sys.stderr)
            sys.exit(1)
        sys.exit(0)

    # Security: check blocked tools (router handles all other permissions)
    if is_tool_blocked(tool_name):
        print(f"Error: Tool '{tool_name}' is blocked", file=sys.stderr)
        sys.exit(1)

    # Parse arguments (JSON or Python dict syntax)
    if len(args) > 1:
        try:
            tool_args = parse_args(args[1])
        except ValueError as e:
            print(f"Invalid arguments: {e}", file=sys.stderr)
            sys.exit(1)
    else:
        tool_args = {}

    # Inject caller identity for router permission resolution
    if caller_id:
        tool_args["_caller"] = caller_id

    # Call the tool via router
    try:
        result = call_tool(tool_name, tool_args)

        # Output as JSON for easy parsing
        if isinstance(result, (dict, list)):
            print(json.dumps(result, indent=2))
        else:
            print(result)
    except Exception as e:
        print(f"Error calling {tool_name}: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
