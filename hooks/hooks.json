{
  "description": "Agent-swarm enforcement hooks",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/fearsidhe/.claude/plugins/agent-swarm/hooks/telemetry-pretool.py",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "python3 /home/fearsidhe/.claude/plugins/agent-swarm/hooks/base-enforcement.py",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "python3 /home/fearsidhe/.claude/plugins/agent-swarm/hooks/iterate-enforcement.py",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/fearsidhe/.claude/plugins/agent-swarm/hooks/implementer-only-enforcement.py",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "python3 /home/fearsidhe/.claude/plugins/agent-swarm/hooks/background-enforcement.py",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "bash /home/fearsidhe/.claude/plugins/agent-swarm/hooks/inject-subagent-briefing.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/fearsidhe/.claude/plugins/agent-swarm/hooks/telemetry-posttool.py",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "python3 /home/fearsidhe/.claude/plugins/agent-swarm/hooks/post-tool-tracking.py",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/fearsidhe/.claude/plugins/agent-swarm/hooks/post-task-tracking.py",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "python3 /home/fearsidhe/.claude/plugins/agent-swarm/hooks/work_seeker.py",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/fearsidhe/.claude/plugins/agent-swarm/hooks/pre-compacting.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/fearsidhe/.claude/plugins/agent-swarm/hooks/subagent-enforcement.py",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/fearsidhe/.claude/plugins/agent-swarm/hooks/subagent-complete.py",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/fearsidhe/.claude/plugins/agent-swarm/hooks/session-start.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 /home/fearsidhe/.claude/plugins/agent-swarm/hooks/telemetry-sessionstart.py",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/fearsidhe/.claude/plugins/agent-swarm/hooks/session-end.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}