{
  "description": "Agent-swarm enforcement hooks",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/fearsidhe/.claude/plugins/agent-swarm/hooks/native-tool-blocking.py",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/fearsidhe/.claude/plugins/agent-swarm/hooks/pre-compacting.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/fearsidhe/.claude/plugins/agent-swarm/hooks/session-start.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/fearsidhe/.claude/plugins/agent-swarm/hooks/session-end.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
