{
  "orchestrator": {
    "model": "opus",
    "description": "Main coordinator - only component using expensive model"
  },
  "autopilot": {
    "enabled": false,
    "suppress_non_workflow_prompts": false,
    "auto_approve_tools": false
  },
  "checkpoints": {
    "intake": true,
    "research": true,
    "explore": true,
    "design": true,
    "implement": true,
    "review": true,
    "debug": false,
    "git": true
  },
  "phases": {
    "intake": {
      "description": "Understand request, classify complexity",
      "checkpoint": true,
      "agents": []
    },
    "research": {
      "description": "Deep research for complex/unfamiliar domains",
      "checkpoint": false,
      "agents": [
        "researcher"
      ]
    },
    "explore": {
      "description": "Codebase exploration for normal complexity",
      "checkpoint": false,
      "agents": [
        "explorer"
      ]
    },
    "design": {
      "description": "Architecture and implementation planning",
      "checkpoint": true,
      "agents": [
        "architect"
      ]
    },
    "implement": {
      "description": "Code implementation via subagents",
      "checkpoint": false,
      "agents": [
        "implementer"
      ],
      "model": "opus",
      "enforce_subagents": true
    },
    "review": {
      "description": "Code review and quality check",
      "checkpoint": true,
      "agents": [
        "reviewer"
      ]
    },
    "debug": {
      "description": "Debugging and fixing issues",
      "checkpoint": false,
      "agents": [
        "debugger"
      ]
    },
    "git": {
      "description": "Version control operations",
      "checkpoint": true,
      "agents": [
        "git-agent"
      ]
    }
  },
  "iteration_modes": {
    "iterate": {
      "description": "Tight implement-test-review loop with adversarial testing",
      "optional_phases": ["intake", "design"],
      "loop_phases": ["implement", "adversary", "review"],
      "max_iterations": 5,
      "checkpoint_interval": 2,
      "checkpoint_after_loop": true,
      "exit_conditions": ["tests_pass", "review_approved", "max_reached"],
      "agents": ["implementer", "adversary", "reviewer"],
      "adversary": {
        "enabled": true,
        "scopes": ["commit", "pr", "codebase"],
        "default_scope": "commit",
        "max_tests_per_cycle": 10,
        "max_adversary_loops": 3,
        "greptile_genius": true,
        "greptile_queries": {
          "gap_discovery": "Review tests for [files]. Should passing tests give confidence?",
          "test_validation": "Are these tests legitimate, fair, and testing real behavior?",
          "final_review": "Tests are solid. Review implementation for bugs and security."
        }
      }
    }
  },
  "execution": {
    "prefer_parallel": true,
    "max_concurrent_subagents": 3,
    "batch_tool_calls": true,
    "background_tasks_enabled": true
  },
  "orchestrate": {
    "max_agents": 3,
    "review_poll_interval_minutes": 5,
    "vague_input_keywords": ["create", "build", "design", "implement", "add", "make"],
    "vague_input_patterns": ["^[^/]+$", ".*without specifics.*"],
    "auto_intake_threshold": 0.5
  },
  "enforcement": {
    "description": "Three-layer token efficiency enforcement",
    "proactive_warnings": {
      "enabled": true,
      "search_threshold_50_percent": 3,
      "search_threshold_80_percent": 4,
      "read_threshold_50_percent": 3,
      "read_threshold_80_percent": 4,
      "description": "Warn agents at 50% and 80% of limits before blocking"
    },
    "pattern_detection": {
      "enabled": true,
      "lookback_messages": 3,
      "min_batch_size": 5,
      "description": "Detect batch operation intent early via regex patterns"
    },
    "mandatory_compliance": {
      "enabled": true,
      "required_tools": ["Task", "Write"],
      "description": "Block non-compliant tools after initial block"
    }
  }
}
