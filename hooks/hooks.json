{
  "description": "Agent-swarm enforcement hooks",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${AGENT_SWARM_ROOT}/hooks/agent-dispatch.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${AGENT_SWARM_ROOT}/hooks/enforce-agent-registration.py",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${AGENT_SWARM_ROOT}/hooks/enforce-workflow-completion.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${AGENT_SWARM_ROOT}/hooks/native-tool-blocking.py",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${AGENT_SWARM_ROOT}/hooks/pre-compacting.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${AGENT_SWARM_ROOT}/hooks/session-start.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${AGENT_SWARM_ROOT}/hooks/session-end.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
